PORT=3003

# Auth mode:
# - optional (default): token facultatif, endpoints utilisables sans Keycloak
# - required: token obligatoire + variables Keycloak obligatoires
# - off: aucune auth (utile pour dev rapide)
AUTH_MODE=optional

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=hessbnb

# Keycloak / OIDC
KEYCLOAK_ISSUER=
KEYCLOAK_JWKS_URL=
KEYCLOAK_AUDIENCE=

